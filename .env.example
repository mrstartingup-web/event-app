# Bloom & Aisle Events — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` for LOCAL development only:
#     cp .env.example .env      # then fill in the values
#
# Never commit a real `.env` (`.gitignore` covers `.env` and `.env.*`).
# On the live site these values are read from the host's environment
# (`process.env`), NOT from a `.env` file — a `.env` file is not published,
# so a secret that only lives there is simply missing in production.
#
# Nothing in this project hardcodes a key: every value below is read on the
# server from `process.env` (see `src/lib/config.server.ts`).
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
# Safe for the browser (exposed through /api/config).
SUPABASE_URL=

# Supabase anon (public) API key. Safe for the browser: Row Level Security is
# what protects the data, not this key (exposed through /api/config).
SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY — bypasses Row Level Security.
# Used for admin/system tasks (e.g. pushing ADMIN_EMAIL into `app_config`).
# Never send this to the browser and never print it in a log.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for `psql` / migrations, e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# SERVER ONLY. Used locally to apply supabase/migrations/*.sql.
SUPABASE_DB_URL=

# The Planner's login email. Exactly one account with this email becomes the
# admin (see supabase/migrations/0001_init.sql). Not a secret, but do not
# expose it to customers: it is pushed into the `app_config` table server-side.
ADMIN_EMAIL=

# The Planner's WhatsApp number in international format, digits only, e.g.
# 60123456789 (used to build the "Chat on WhatsApp" wa.me link).
WHATSAPP_NUMBER=
